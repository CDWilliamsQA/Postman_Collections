		{
			"name": "skill check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the response JSON\r",
							"let responseData = pm.response.json();\r",
							"\r",
							"//get the actorName value\r",
							"let actor = responseData.actorName;\r",
							"\r",
							"\r",
							"//Save as a new collection variable\r",
							"pm.collectionVariables.set(\"favouriteActor\",actor);\r",
							"\r",
							"//log it for confirmation\r",
							"console.log(\"Favourite Actor saved\",actor);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "apikey",
					"apikey": [
						{
							"key": "value",
							"value": "skillcheck",
							"type": "string"
						},
						{
							"key": "key",
							"value": "student-expert",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"actorName\": \"Matthew McConaughey\"\r\n}    ",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{skillcheckbaseURL}}/post?movieName=Interstellar",
					"host": [
